name: Deploy develop to qa

on:
  push:
    branches:
      - develop

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Merge to qa
        run: |
          git fetch --all
          git checkout qa
          git merge origin/develop --no-ff -m "Merge from develop to qa"
          git push origin qa
